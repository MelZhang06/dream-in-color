---
import { getCollection, render } from 'astro:content';
const {compact=false}=Astro.props;
const dreams=(await getCollection('dreams')).sort((a,b)=>a.data.order-b.data.order);
const memories=await Promise.all(dreams.map(async dream=>({dream,...await render(dream)})));
---
<div class:list={["dream-water",{"home-bubble-water":compact}]} data-dream-water data-desktop-count={compact?6:8} data-mobile-count={compact?2:4}>
{dreams.map((dream,index)=><button type="button" class:list={['dream-bubble',`bubble-slot-${index%8}`,`mobile-slot-${index%4}`,{'gallery-visible':index<(compact?6:8),'mobile-visible':index<(compact?2:4)}]} style={`--slot:${index};--delay:-${index*3}s;--duration:${23+index*2}s;`} data-bubble={index} aria-haspopup="dialog" aria-controls={`memory-${dream.data.number}`} aria-label={`Open dream ${dream.data.number}: ${dream.data.title}`}><span class="bubble-skin"><img src={dream.data.image} alt="" width={dream.data.width} height={dream.data.height} loading={index<4?'eager':'lazy'}/></span><span class="bubble-glint" aria-hidden="true"></span><span class="bubble-spray" aria-hidden="true">{Array.from({length:12},(_,i)=><span style={`--angle:${i*30}deg;--px:${50+Math.cos(i*Math.PI/6)*46}%;--py:${50+Math.sin(i*Math.PI/6)*46}%;--dx:${Math.cos(i*Math.PI/6)*.5};--dy:${Math.sin(i*Math.PI/6)*.5};--spark-delay:${(i%3)*18}ms;`}></span>)}</span><span class="bubble-name">{dream.data.title}</span></button>)}

</div>
<div class="bubble-bottom"><p>Touch a dream.</p><button type="button" class="bubble-pause" data-bubble-pause aria-label="Pause floating dreams">Pause</button></div>

{memories.map(({dream,Content})=><dialog class="dream-reveal" id={`memory-${dream.data.number}`} aria-labelledby={`title-${dream.data.number}`}><button class="memory-close" type="button" aria-label="Close dream">Close <span aria-hidden="true">×</span></button><div class="reveal-layout"><figure><img src={dream.data.image} alt={dream.data.alt} width={dream.data.width} height={dream.data.height}/></figure><div class="reveal-memory"><span class="eyebrow">Dream {dream.data.number}</span><h2 id={`title-${dream.data.number}`}>{dream.data.title}</h2><div class="memory-english"><Content/></div><p class="memory-chinese" lang="zh">{dream.data.memoryZh}</p><a class="text-link" href={`/dreams/${dream.id}/`}>Visit this dream ↗</a></div></div></dialog>)}
<script>
const water=document.querySelector<HTMLElement>('[data-dream-water]');
const bubbles=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-bubble]'));
const dialogs=Array.from(document.querySelectorAll<HTMLDialogElement>('.dream-reveal'));
const pause=document.querySelector<HTMLButtonElement>('[data-bubble-pause]');
const reduced=matchMedia('(prefers-reduced-motion: reduce)');
const mobile=matchMedia('(max-width: 760px)');
let paused=reduced.matches, opening=false;
let returnTo:HTMLButtonElement|null=null;
function updatePause(){water?.classList.toggle('is-paused',paused);if(pause){pause.textContent=paused?'Play':'Pause';pause.setAttribute('aria-label',paused?'Play floating dreams':'Pause floating dreams');}}
pause?.addEventListener('click',()=>{paused=!paused;updatePause();});
reduced.addEventListener('change',()=>{paused=reduced.matches;updatePause();});
bubbles.forEach(bubble=>bubble.addEventListener('click',()=>{
 if(opening)return;
 const dialog=document.getElementById(bubble.getAttribute('aria-controls')??'') as HTMLDialogElement|null;
 if(!dialog)return;
 opening=true;returnTo=bubble;water?.classList.add('is-opening');bubble.classList.add('is-bursting');
 window.setTimeout(()=>{dialog.showModal();document.body.classList.add('memory-open');opening=false;},reduced.matches?0:480);
}));
dialogs.forEach(dialog=>{
 dialog.querySelector('.memory-close')?.addEventListener('click',()=>dialog.close());
 dialog.addEventListener('click',event=>{if(event.target!==dialog)return;const r=dialog.getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom)dialog.close();});
 dialog.addEventListener('close',()=>{document.body.classList.remove('memory-open');water?.classList.remove('is-opening');returnTo?.classList.remove('is-bursting');returnTo?.focus();});
});
// Each bubble has its own ascent, then hands its place to another memory.
type RisingDream={bubble:HTMLButtonElement;progress:number;duration:number;lane:number;size:number;drift:number;end:number;popElapsed:number};
let flights:RisingDream[]=[],lastTime=0,nextDream=0,fieldWidth=0;
function makeFlight(bubble:HTMLButtonElement,lane:number,progress=0):RisingDream{
 const width=water?.clientWidth??600,height=water?.clientHeight??340;
 const size=Math.max(62,Math.min(width*(mobile.matches?.55:.18),height*.32)*(.8+Math.random()*.3));
 bubble.style.setProperty('--random-size',`${size}px`);
 bubble.classList.remove('is-auto-popping');bubble.style.opacity='0';
 return {bubble,lane,progress,size,popElapsed:0,duration:22+Math.random()*12,drift:Math.random()*Math.PI*2,end:size*.55+20+Math.random()*35};
}
function startFlights(){
 if(!water)return;
 const count=Math.min(bubbles.length,Number(mobile.matches?water.dataset.mobileCount:water.dataset.desktopCount));
 bubbles.forEach(b=>{b.classList.remove('gallery-visible','mobile-visible','is-auto-popping');b.style.opacity='0';});
 const lanes=Array.from({length:count},(_,i)=>i).sort(()=>Math.random()-.5);
 flights=bubbles.slice(0,count).map((bubble,i)=>{
  bubble.classList.add('gallery-visible','mobile-visible');
  return makeFlight(bubble,lanes[i],.08+i/count*.8);
 });
 nextDream=count;fieldWidth=water.clientWidth;
 water.classList.add('rising-water');
}
function rise(time:number){
 const dt=lastTime?Math.min(time-lastTime,50)/1000:0;lastTime=time;
 if(water){
  const advancing=!paused&&!opening&&!document.hidden&&!dialogs.some(d=>d.open);
  const width=water.clientWidth,height=water.clientHeight;
  flights.forEach((flight,index)=>{
   let {bubble}=flight;
   if(advancing&&!bubble.matches(':hover,:focus-visible'))flight.progress+=dt/flight.duration;
   if(flight.progress>=1&&advancing)flight.popElapsed+=dt;
   if(flight.popElapsed>=1.1){
    const available=bubbles.filter(b=>!flights.some(f=>f.bubble===b));
    const replacement=available.find(b=>Number(b.dataset.bubble)>=nextDream)||available[0]||bubble;
    bubble.classList.remove('gallery-visible','mobile-visible','is-auto-popping');bubble.style.opacity='0';
    replacement.classList.add('gallery-visible','mobile-visible');
    nextDream=(Number(replacement.dataset.bubble)+1)%bubbles.length;
    flight=makeFlight(replacement,flight.lane);flights[index]=flight;bubble=replacement;
   }
   const p=Math.min(flight.progress,1),margin=flight.size*.55+15;
   const laneX=margin+(width-2*margin)*(flight.lane+.5)/flights.length;
   const sway=Math.sin(p*5+flight.drift)*(mobile.matches?10:22);
   const x=Math.max(margin,Math.min(width-margin,laneX+sway));
   const y=height+flight.size*.6-p*(height+flight.size*.6-flight.end);
   bubble.style.left=`${x}px`;bubble.style.top=`${y}px`;
   bubble.style.transform=`translate(-50%,-50%) rotate(${Math.sin(p*4+flight.drift)*3}deg)`;
   bubble.style.opacity=String(Math.min(1,p*18));
   bubble.classList.toggle('is-auto-popping',flight.progress>=1);
  });
 }
 requestAnimationFrame(rise);
}
if(water){
 startFlights();
 new ResizeObserver(()=>{if(water.clientWidth!==fieldWidth)startFlights();}).observe(water);
 mobile.addEventListener('change',startFlights);
 requestAnimationFrame(rise);
}
updatePause();
</script>