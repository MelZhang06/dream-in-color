---
import '../styles/global.css';
import '../styles/editorial.css';
interface Props { title?: string; description?: string; lang?: string; dark?: boolean; immersive?: boolean; }
const { title = 'The Waking Hours & Other Dreams', description = 'Essays from waking life. Images remembered from dreams.', lang = 'en', dark = false, immersive = false } = Astro.props;
const path = Astro.url.pathname;
const canonical = Astro.site ? new URL(path, Astro.site) : undefined;
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<meta name="theme-color" content={dark || immersive ? '#181c29' : '#f8f7f3'} />
<title>{title === 'The Waking Hours & Other Dreams' ? title : `${title} — The Waking Hours & Other Dreams`}</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,400;1,400&display=swap" rel="stylesheet" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
{canonical && <link rel="canonical" href={canonical} />}
<slot name="head" />
</head>
<body class:list={["threshold-design", { dark, immersive, "about-screen": path === "/about/", "writing-room": path.startsWith("/writing"), "home-screen": path === "/", "home-dreamy": path === "/" || path === "/about/" }]}>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header wrap">
<a class="wordmark" href="/" aria-label="The Waking Hours & Other Dreams Home"><span>The Waking Hours</span> <span class="wordmark-amp">&amp;</span> <em>Other Dreams</em></a>
<nav aria-label="Main navigation">
<a href="/" aria-current={path === "/" ? "page" : undefined}>Home</a>
<a href="/writing/" aria-current={path.startsWith('/writing') ? 'page' : undefined}>Writing</a>
<a href="/dreams/" aria-current={path.startsWith('/dreams') ? 'page' : undefined}>Dream Archive</a>
<a href="/about/" aria-current={path.startsWith('/about') ? 'page' : undefined}>About</a>
</nav>
</header>
<main id="main"><slot /></main>
<footer class="site-footer wrap"><a href="/">The Waking Hours & Other Dreams</a><span>A personal journal & dream archive</span><a href="#main">Back to top</a></footer>
</body>
</html>
