---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const dreams = (await getCollection('dreams')).sort((a,b) => a.data.order - b.data.order);
const cover = dreams[0];
const essays = (await getCollection('writing')).sort((a,b) => a.data.order - b.data.order);
const originals = [...new Set(essays.map(e => e.data.translationKey))];
---
<Layout immersive>
<section class="dream-entry" aria-labelledby="dream-question">
<div class="entry-topline"><span>A journal of waking & dreaming</span><span>01 / The beginning</span></div>
<div class="entry-composition">
<div class="entry-title"><span class="eyebrow">A question, before you enter</span><h1 id="dream-question">Do you <br /><span class="dream-word">dream</span> <br />in <em>color?</em></h1><p lang="zh">你会做彩色的梦吗？</p></div>
<div class="dream-carousel" aria-label="Dream slideshow">
{dreams.map((dream,index) => <figure class:list={['dream-window','dream-slide',{'is-active':index===0}]} hidden={index!==0} data-dream-slide><a href={`/dreams/${dream.id}/`} aria-label={`Enter dream ${dream.data.number}: ${dream.data.title}`}><img src={dream.data.image} alt={dream.data.alt} width={dream.data.width} height={dream.data.height} fetchpriority={index===0 ? 'high' : 'auto'} /><span class="window-caption">Enter the dream</span></a><figcaption><span>Dream {dream.data.number}</span><span>{dream.data.title}</span></figcaption></figure>)}
{dreams.length>1 && <div class="dream-controls"><button type="button" data-dream-prev aria-label="Previous dream">←</button><span data-dream-count aria-live="polite">1 / {dreams.length}</span><button type="button" data-dream-next aria-label="Next dream">→</button><button type="button" data-dream-pause aria-label="Pause slideshow">Pause</button></div>}
</div>
<span class="vertical-note" aria-hidden="true">Between waking & dreaming</span>
</div>
<div class="entry-bottom"><p>What I think about when awake.<br />What I remember when I wake.</p><a href="#memory">A little further down</a><span aria-hidden="true">✳</span></div>
</section>
<section id="memory" class="memory-passage" aria-label="A remembered moment"><span class="eyebrow">A fragment of Dream 001</span><p class="memory-line">I was asleep.</p><p class="memory-line">Then I heard the others.</p><p class="memory-line last">I opened my eyes.<br /><em>How beautiful.</em></p><p class="memory-original" lang="zh">睁眼望向窗外。心里惊呼：好美。</p><a class="text-link" href={cover ? `/dreams/${cover.id}/` : '/dreams/'}>Read the memory</a></section>
<div class="waking-world"><section class="writing-section wrap" aria-labelledby="writing-title"><div class="waking-label"><span class="eyebrow">On the other side of sleep</span><span aria-hidden="true">✳</span></div><div class="section-heading"><h2 id="writing-title">Meanwhile,<br /><em>in waking life.</em></h2><a class="text-link" href="/writing/">All writing</a></div>
{originals.map(key => { const versions = essays.filter(e => e.data.translationKey === key); const en = versions.find(e => e.data.lang === 'en'); const zh = versions.find(e => e.data.lang === 'zh'); const essay = en ?? versions[0]; return <a class="essay-row" href={`/writing/${essay.id}/`}><span class="eyebrow">Writing · {String(essay.data.order).padStart(3,'0')}</span><div><h3>{essay.data.title}</h3>{en && zh && <p class="translation-title" lang="zh">{zh.data.title}</p>}<p class="excerpt">{essay.data.excerpt}</p></div><span class="language-label">{versions.map(e=> e.data.lang === 'en' ? 'EN' : '中文').join(' / ')}</span></a>; })}
</section><section class="archive-note wrap"><span class="eyebrow">The collection continues</span><p>Some things stay<br />after you wake.</p><a class="text-link" href="/dreams/">Visit the dream archive</a></section></div>
<script>
const slides = Array.from(document.querySelectorAll<HTMLElement>('[data-dream-slide]'));
const carousel = document.querySelector<HTMLElement>('.dream-carousel');
const pauseButton = document.querySelector<HTMLButtonElement>('[data-dream-pause]');
const count = document.querySelector<HTMLElement>('[data-dream-count]');
let current = 0;
let paused = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
let timer: ReturnType<typeof setInterval> | undefined;
function showDream(index: number) {
  current = (index + slides.length) % slides.length;
  slides.forEach((slide,i) => { slide.hidden = i !== current; slide.classList.toggle('is-active',i === current); });
  if (count) count.textContent = `${current + 1} / ${slides.length}`;
}
function stopTimer() { if (timer) clearInterval(timer); timer = undefined; }
function startTimer() { stopTimer(); if (!paused && slides.length > 1) timer = setInterval(() => showDream(current + 1),8000); }
function updatePause() { if (pauseButton) { pauseButton.textContent = paused ? 'Play' : 'Pause'; pauseButton.setAttribute('aria-label',paused ? 'Play slideshow' : 'Pause slideshow'); } }
document.querySelector('[data-dream-prev]')?.addEventListener('click',() => { showDream(current - 1); startTimer(); });
document.querySelector('[data-dream-next]')?.addEventListener('click',() => { showDream(current + 1); startTimer(); });
pauseButton?.addEventListener('click',() => { paused = !paused; updatePause(); startTimer(); });
carousel?.addEventListener('mouseenter',stopTimer);
carousel?.addEventListener('mouseleave',startTimer);
carousel?.addEventListener('focusin',stopTimer);
carousel?.addEventListener('focusout',event => { if (!carousel.contains(event.relatedTarget as Node)) startTimer(); });
document.addEventListener('visibilitychange',() => { if (document.hidden) stopTimer(); else startTimer(); });
updatePause(); startTimer();
const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
if (!reduced.matches && 'IntersectionObserver' in window) {
  const observer = new IntersectionObserver(entries => { for (const entry of entries) { if (entry.isIntersecting) { entry.target.classList.add('in-view'); observer.unobserve(entry.target); } } }, { threshold: 0.3 });
  document.querySelectorAll('.memory-line').forEach(line => { line.classList.add('reveal-ready'); observer.observe(line); });
}
</script>
</Layout>
