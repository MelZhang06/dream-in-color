---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const firstDream=(await getCollection('dreams')).sort((a,b)=>a.data.order-b.data.order)[0];
---
<Layout title="Between waking & dreaming">
<section class="threshold-home wrap" aria-labelledby="home-title">
<div class="threshold-kicker"><h1 id="home-title">Between waking &amp; dreaming</h1><span>A personal journal &amp; dream archive</span></div>
<div class="threshold-spread">
<a href="/writing/" class="threshold-entrance waking-entrance">
<div class="threshold-chapter"><span>01 / Waking</span><span aria-hidden="true">↗</span></div>
<div class="waking-fragment"><span class="fragment-source">From Here On</span><blockquote>Perhaps the point<br class="desktop-break" /> lies precisely in the fact<br class="desktop-break" /> that we do it <em>neither<br class="desktop-break" /> quickly nor perfectly.</em></blockquote><span class="fragment-note">A thought, kept.</span></div>
<div class="threshold-label"><h2>Writing</h2><p>What I think about when awake.</p></div>
</a>
<a href="/dreams/" class="threshold-entrance dreaming-entrance">
<div class="threshold-chapter"><span>02 / Dreaming</span><span aria-hidden="true">↗</span></div>
{firstDream && <figure class="threshold-window"><img src={firstDream.data.image} alt={firstDream.data.alt} width={firstDream.data.width} height={firstDream.data.height} fetchpriority="high"/><figcaption><span>Dream {firstDream.data.number}</span><span>{firstDream.data.title}</span></figcaption></figure>}
<div class="threshold-label"><h2>Dreams</h2><p>What I remember when I wake.</p></div>
</a>
</div>
<div class="threshold-colophon"><span>Words written by hand.</span><span>Images carried back from sleep.</span></div>
</section>
<div class="cursor-halo" aria-hidden="true"></div>
<script>
// Touch uses an explicit preview step instead of browser-dependent hover.
const touchChoices=Array.from(document.querySelectorAll<HTMLAnchorElement>('.threshold-entrance'));
const touchInput=matchMedia('(hover: none), (pointer: coarse)');
let previewChoice:HTMLAnchorElement|null=null;
touchChoices.forEach(choice=>choice.addEventListener('click',event=>{
 if(!touchInput.matches)return;
 if(previewChoice===choice)return;
 event.preventDefault();
 touchChoices.forEach(item=>item.classList.remove('is-previewing'));
 choice.classList.add('is-previewing');previewChoice=choice;
}));
document.addEventListener('click',event=>{
 if((event.target as Element)?.closest('.threshold-entrance'))return;
 touchChoices.forEach(item=>item.classList.remove('is-previewing'));previewChoice=null;
});
const halo=document.querySelector<HTMLElement>('.cursor-halo');
const fine=matchMedia('(pointer: fine)');
if(halo && fine.matches){
 let targetX=-100,targetY=-100,x=-100,y=-100,started=false,last=0;
 const reduced=matchMedia('(prefers-reduced-motion: reduce)');
 window.addEventListener('pointermove',event=>{
  targetX=event.clientX;targetY=event.clientY;
  if(!started){x=targetX;y=targetY;started=true;}
  halo.classList.add('is-visible');halo.classList.toggle('is-over-link',!!(event.target as Element)?.closest('a'));
 });
 function follow(time:number){
  const dt=last?Math.min(time-last,64):16;last=time;
  const ease=reduced.matches?1:1-Math.exp(-dt/145);
  x+=(targetX-x)*ease;y+=(targetY-y)*ease;
  halo!.style.setProperty('--halo-x',`${x}px`);halo!.style.setProperty('--halo-y',`${y}px`);
  requestAnimationFrame(follow);
 }
 requestAnimationFrame(follow);
 document.documentElement.addEventListener('pointerleave',()=>{halo.classList.remove('is-visible');started=false;});
 window.addEventListener('blur',()=>{halo.classList.remove('is-visible');started=false;});
}
</script>
</Layout>
