---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const dreams = (await getCollection('dreams')).sort((a,b) => a.data.order - b.data.order);
const essays = (await getCollection('writing')).sort((a,b) => a.data.order - b.data.order);
const originals = [...new Set(essays.map(e => e.data.translationKey))];
---
<Layout immersive>
<section class="orbit-cover" aria-label="Dream gallery">
<div class="orbit-intro"><span class="eyebrow">Between waking & dreaming</span><h1>Do you dream<br />in <em>color?</em></h1><p class="orbit-lines">What I think about when awake.<br />What I remember when I wake.</p></div>
<div class="orbit-stage" data-orbit-stage>{dreams.map((dream,index) => <a class:list={['orbit-card',{'orbit-front':index===0,'orbit-right':index===1}]} href={`/dreams/${dream.id}/`} data-orbit-card data-title={dream.data.title} data-number={dream.data.number} aria-label={`Read ${dream.data.title}`}><img src={dream.data.image} alt={dream.data.alt} width={dream.data.width} height={dream.data.height} loading={index===0 ? 'eager':'lazy'} /><span class="orbit-card-note">Dream {dream.data.number} · Read the memory ↗</span></a>)}</div>
<div class="orbit-footer"><span class="orbit-motto" aria-hidden="true">✳</span><div class="orbit-selection"><span data-orbit-caption>Dream {dreams[0]?.data.number} · {dreams[0]?.data.title}</span><div class="orbit-buttons"><button type="button" data-orbit-prev aria-label="Previous dream">←</button><span data-orbit-count>1 / {dreams.length}</span><button type="button" data-orbit-next aria-label="Next dream">→</button></div></div><a class="text-link" href="/dreams/">View all dreams ↗</a></div>
<p class="orbit-hint">Drag to wander · Click the front image to enter</p>
</section>
<div class="waking-world"><section class="writing-section wrap" aria-labelledby="writing-title"><div class="waking-label"><span class="eyebrow">On the other side of sleep</span><span aria-hidden="true">✳</span></div><div class="section-heading"><h2 id="writing-title">Meanwhile,<br /><em>in waking life.</em></h2><a class="text-link" href="/writing/">All writing</a></div>
{originals.map(key => { const versions = essays.filter(e => e.data.translationKey === key); const en = versions.find(e => e.data.lang === 'en'); const zh = versions.find(e => e.data.lang === 'zh'); const essay = en ?? versions[0]; return <a class="essay-row" href={`/writing/${essay.id}/`}><span class="eyebrow">Writing · {String(essay.data.order).padStart(3,'0')}</span><div><h3>{essay.data.title}</h3>{en && zh && <p class="translation-title" lang="zh">{zh.data.title}</p>}<p class="excerpt">{essay.data.excerpt}</p></div><span class="language-label">{versions.map(e=> e.data.lang === 'en' ? 'EN' : '中文').join(' / ')}</span></a>; })}
</section><section class="archive-note wrap"><span class="eyebrow">The collection continues</span><p>Some things stay<br />after you wake.</p><a class="text-link" href="/dreams/">Visit the dream archive</a></section></div>

<script>
const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-orbit-card]'));
const stage = document.querySelector<HTMLElement>('[data-orbit-stage]');
let active = 0;
let startX = 0;
let dragging = false;
let moved = false;
function arrange(index: number) {
 active = (index + cards.length) % cards.length;
 cards.forEach((card,i) => {
   const offset = (i-active+cards.length)%cards.length;
   card.classList.remove('orbit-front','orbit-left','orbit-right','orbit-away');
   card.classList.add(offset===0 ? 'orbit-front' : offset===1 ? 'orbit-right' : offset===cards.length-1 ? 'orbit-left' : 'orbit-away');
   card.setAttribute('aria-label',`${i===active ? 'Read' : 'Bring forward'} ${card.dataset.title}`);
   card.tabIndex = offset<=1 || offset===cards.length-1 ? 0 : -1;
 });
 const caption = document.querySelector('[data-orbit-caption]');
 const count = document.querySelector('[data-orbit-count]');
 if(caption) caption.textContent = `Dream ${cards[active].dataset.number} · ${cards[active].dataset.title}`;
 if(count) count.textContent = `${active+1} / ${cards.length}`;
}
cards.forEach((card,i) => card.addEventListener('click',event => {
 if(moved) { event.preventDefault(); moved=false; return; }
 if(i!==active) { event.preventDefault(); arrange(i); }
}));
document.querySelector('[data-orbit-prev]')?.addEventListener('click',()=>arrange(active-1));
document.querySelector('[data-orbit-next]')?.addEventListener('click',()=>arrange(active+1));
stage?.addEventListener('pointerdown',event=> { startX=event.clientX; dragging=true; moved=false; });
stage?.addEventListener('pointermove',event=> { if(dragging && Math.abs(event.clientX-startX)>15) moved=true; });
window.addEventListener('pointerup',event=> { if(!dragging) return; dragging=false; const distance=event.clientX-startX; if(Math.abs(distance)>45) arrange(active+(distance<0 ? 1 : -1)); });
stage?.addEventListener('pointercancel',()=> { dragging=false; moved=false; });
stage?.addEventListener('dragstart',event=>event.preventDefault());
let autoplay: ReturnType<typeof setInterval> | undefined;
const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
function stopOrbit() { if(autoplay) clearInterval(autoplay); autoplay=undefined; }
function startOrbit() { stopOrbit(); if(!reducedMotion.matches && !document.hidden && !stage?.matches(':hover') && !stage?.contains(document.activeElement) && cards.length>1) autoplay=setInterval(()=>arrange(active+1),7000); }
stage?.addEventListener('mouseenter',stopOrbit);
stage?.addEventListener('mouseleave',startOrbit);
stage?.addEventListener('focusin',stopOrbit);
stage?.addEventListener('focusout',()=>setTimeout(startOrbit,0));
stage?.addEventListener('pointerdown',stopOrbit);
window.addEventListener('pointerup',startOrbit);
document.addEventListener('visibilitychange',startOrbit);
reducedMotion.addEventListener('change',startOrbit);
document.querySelector('[data-orbit-prev]')?.addEventListener('click',startOrbit);
document.querySelector('[data-orbit-next]')?.addEventListener('click',startOrbit);
arrange(0); startOrbit();
</script>
</Layout>
