---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const essays=(await getCollection('writing')).sort((a,b)=>b.data.order-a.data.order);
const latest=essays[0];
const firstDream=(await getCollection('dreams')).sort((a,b)=>a.data.order-b.data.order)[0];
const previewText=latest?.body?.split('\n\n').slice(0,3).join(' ') ?? latest?.data.excerpt;
---
<Layout title="Between waking & dreaming">
<section class="quiet-home wrap" aria-labelledby="home-title"><h1 id="home-title">Between waking & dreaming</h1><div class="home-choices"><a href="/writing/" class="home-choice" aria-label="Writing — What I think about when awake"><span class="choice-letter" aria-hidden="true">W</span><h2>Writing</h2><p>What I think about when awake.</p>{latest && <div class="choice-preview writing-peek" aria-hidden="true"><span class="peek-label">Latest writing · 中文</span><h3 lang={latest.data.lang}>{latest.data.title}</h3><p lang={latest.data.lang}>{previewText}</p><span class="peek-end">✳</span></div>}</a><a href="/dreams/" class="home-choice" aria-label="Dreams — What I remember when I wake"><span class="choice-letter" aria-hidden="true">D</span><h2>Dreams</h2><p>What I remember when I wake.</p>{firstDream && <figure class="choice-preview dream-peek" aria-hidden="true"><img src={firstDream.data.image} alt="" width={firstDream.data.width} height={firstDream.data.height}/><figcaption>Dream {firstDream.data.number} · {firstDream.data.title}</figcaption></figure>}</a></div></section>
<div class="cursor-halo" aria-hidden="true"></div>
<script>
const halo=document.querySelector<HTMLElement>('.cursor-halo');
const fine=matchMedia('(pointer: fine)');
if(halo && fine.matches){
 let targetX=-100,targetY=-100,x=-100,y=-100,started=false,last=0;
 const reduced=matchMedia('(prefers-reduced-motion: reduce)');
 window.addEventListener('pointermove',event=>{
  targetX=event.clientX;targetY=event.clientY;
  if(!started){x=targetX;y=targetY;started=true;}
  halo.classList.add('is-visible');halo.classList.toggle('is-over-link',!!(event.target as Element)?.closest('a'));
 });
 function follow(time:number){
  const dt=last?Math.min(time-last,64):16;last=time;
  const ease=reduced.matches?1:1-Math.exp(-dt/145);
  x+=(targetX-x)*ease;y+=(targetY-y)*ease;
  halo!.style.setProperty('--halo-x',`${x}px`);halo!.style.setProperty('--halo-y',`${y}px`);
  requestAnimationFrame(follow);
 }
 requestAnimationFrame(follow);
 document.documentElement.addEventListener('pointerleave',()=>{halo.classList.remove('is-visible');started=false;});
 window.addEventListener('blur',()=>{halo.classList.remove('is-visible');started=false;});
}
</script>
</Layout>
