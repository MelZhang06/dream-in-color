---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const dreams=(await getCollection('dreams')).sort((a,b)=>a.data.order-b.data.order);
---
<Layout title="Dreams" immersive>
<section id="dream-index" class="memory-atlas archive-direct wrap" aria-labelledby="atlas-title"><header class="atlas-heading"><div><span class="eyebrow">The complete archive · {String(dreams.length).padStart(2,'0')} fragments</span><h2 id="atlas-title">Places I remember.</h2></div><p>Some are worlds.<br/>Some are only moments.</p></header><div class="atlas-grid">{dreams.map(dream=><a class:list={['atlas-item',`atlas-item-${dream.data.number}`]} href={`/dreams/${dream.id}/`}><figure><img src={dream.data.image} alt={dream.data.alt} width={dream.data.width} height={dream.data.height} loading="lazy"/></figure><div class="atlas-caption"><span>{dream.data.number}</span><h3>{dream.data.title}</h3><span aria-hidden="true">↗</span></div>{['007','008'].includes(dream.data.number)&&<p class="atlas-relation">Two scenes from the same dream</p>}</a>)}</div></section></Layout>