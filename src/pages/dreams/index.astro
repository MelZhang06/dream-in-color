---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const dreams=(await getCollection('dreams')).sort((a,b)=>a.data.order-b.data.order);
const selectedDreams = dreams.filter(dream => ['001','003','008'].includes(dream.data.number));
---
<Layout title="Dreams" immersive>
<section class="orbit-cover" aria-label="Dream gallery">
<div class="orbit-intro"><span class="eyebrow">Between waking & dreaming</span><h1>Do you dream <br />in <em>color?</em></h1><p class="orbit-lines">What I remember when I wake.</p></div>
<div class="orbit-stage" data-orbit-stage>{selectedDreams.map((dream,index) => <a class:list={['orbit-card',{'orbit-front':index===0,'orbit-right':index===1}]} href={`/dreams/${dream.id}/`} data-orbit-card data-title={dream.data.title} data-number={dream.data.number} aria-label={`Read ${dream.data.title}`}><img src={dream.data.image} alt={dream.data.alt} width={dream.data.width} height={dream.data.height} loading={index===0 ? 'eager':'lazy'} /><span class="orbit-card-note">Dream {dream.data.number} · Read the memory ↗</span></a>)}</div>
<div class="orbit-footer"><span class="orbit-motto" aria-hidden="true"></span><div class="orbit-selection"><span data-orbit-caption>Dream {selectedDreams[0]?.data.number} · {selectedDreams[0]?.data.title}</span><div class="orbit-buttons"><button type="button" data-orbit-prev aria-label="Previous dream">←</button><span data-orbit-count>1 / {selectedDreams.length}</span><button type="button" data-orbit-next aria-label="Next dream">→</button><button type="button" data-orbit-toggle aria-label="Pause gallery">Pause</button></div></div><a class="text-link" href="#dream-index">View all dreams ↗</a></div>
<p class="orbit-hint">Drag to wander · Click the front image to enter</p>
</section>
<section id="dream-index" class="memory-atlas wrap" aria-labelledby="atlas-title"><header class="atlas-heading"><div><span class="eyebrow">The complete archive · {String(dreams.length).padStart(2,'0')} fragments</span><h2 id="atlas-title">Places I remember.</h2></div><p>Some are worlds.<br/>Some are only moments.</p></header><div class="atlas-grid">{dreams.map(dream=><a class:list={['atlas-item',`atlas-item-${dream.data.number}`]} href={`/dreams/${dream.id}/`}><figure><img src={dream.data.image} alt={dream.data.alt} width={dream.data.width} height={dream.data.height} loading="lazy"/></figure><div class="atlas-caption"><span>{dream.data.number}</span><h3>{dream.data.title}</h3><span aria-hidden="true">↗</span></div>{['007','008'].includes(dream.data.number)&&<p class="atlas-relation">Two scenes from the same dream</p>}</a>)}</div></section><script>
const cards=Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-orbit-card]'));
const stage=document.querySelector<HTMLElement>('[data-orbit-stage]');
const toggle=document.querySelector<HTMLButtonElement>('[data-orbit-toggle]');
const reduced=matchMedia('(prefers-reduced-motion: reduce)');
let phase=0, last=0, active=0, hovered=false, focused=false, dragging=false, moved=false, startX=0, paused=reduced.matches;
const step=2*Math.PI/Math.max(cards.length,1);
function render(){
 cards.forEach((card,i)=>{ const angle=phase+i*step, depth=(Math.cos(angle)+1)/2; const x=Math.sin(angle)*(stage?.clientWidth??1000)*.34; card.style.transform=`translate(-50%,-50%) translateX(${x}px) translateY(${(1-depth)*-35}px) rotateY(${-Math.sin(angle)*25}deg) scale(${.55+depth*.45})`; card.style.opacity=String(.35+depth*.65); card.style.zIndex=String(Math.round(depth*100)); card.classList.toggle('orbit-front',depth>.95); card.style.pointerEvents=depth>.05?'auto':'none'; card.tabIndex=depth>.05?0:-1; });
 active=((Math.round(-phase/step)%cards.length)+cards.length)%cards.length;
 const caption=document.querySelector('[data-orbit-caption]'),count=document.querySelector('[data-orbit-count]');
 if(caption && cards[active])caption.textContent=`Dream ${cards[active].dataset.number} · ${cards[active].dataset.title}`;
 if(count)count.textContent=`${active+1} / ${cards.length}`;
}
function frame(time:number){ const dt=last?Math.min(time-last,50):0;last=time;if(!paused&&!hovered&&!focused&&!dragging&&!document.hidden&&cards.length>1)phase-=dt*.000065;render();requestAnimationFrame(frame); }
function select(index:number){phase=-index*step;render();}
cards.forEach((card,i)=>card.addEventListener('click',event=>{if(moved){event.preventDefault();moved=false;return;}const angle=phase+i*step;if(Math.cos(angle)<.95){event.preventDefault();select(i);}}));
document.querySelector('[data-orbit-prev]')?.addEventListener('click',()=>select(active-1));
document.querySelector('[data-orbit-next]')?.addEventListener('click',()=>select(active+1));
function updateToggle(){if(toggle){toggle.textContent=paused?'Play':'Pause';toggle.setAttribute('aria-label',paused?'Play gallery':'Pause gallery');}}
toggle?.addEventListener('click',()=>{paused=!paused;updateToggle();});
reduced.addEventListener('change',()=>{paused=reduced.matches;updateToggle();});
stage?.addEventListener('mouseenter',()=>hovered=true);stage?.addEventListener('mouseleave',()=>hovered=false);
stage?.addEventListener('focusin',()=>focused=true);stage?.addEventListener('focusout',event=>focused=!!stage.contains(event.relatedTarget as Node));
stage?.addEventListener('pointerdown',event=>{dragging=true;moved=false;startX=event.clientX;});
window.addEventListener('pointermove',event=>{if(!dragging)return;const dx=event.clientX-startX;if(Math.abs(dx)>3)moved=true;phase+=dx*.005;startX=event.clientX;});
window.addEventListener('pointerup',()=>dragging=false);stage?.addEventListener('pointercancel',()=>{dragging=false;moved=false;});stage?.addEventListener('dragstart',event=>event.preventDefault());
updateToggle();requestAnimationFrame(frame);
</script></Layout>