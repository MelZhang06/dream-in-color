---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() { return (await getCollection('dreams')).map(dream=>({params:{id:dream.id},props:{dream}})); }
const { dream } = Astro.props;
const { Content } = await render(dream);
---
<Layout title={dream.data.title} description="A remembered dream, reimagined with AI." dark><article class="dream-detail"><header class="wrap dream-heading"><a class="eyebrow" href="/dreams/">Dream Archive · {dream.data.number}</a><h1>{dream.data.title}</h1><p lang="zh">{dream.data.titleZh}</p></header><figure class="dream-full wrap"><img src={dream.data.image} alt={dream.data.alt} width="1024" height="768" fetchpriority="high" /></figure><section class="dream-memory reading"><span class="eyebrow">The memory</span><div class="prose"><Content /><p lang="zh">{dream.data.memoryZh}</p></div><p class="source-note">Created with AI from a remembered dream.</p><a class="text-link" href="/dreams/">All dreams</a></section></article></Layout>
